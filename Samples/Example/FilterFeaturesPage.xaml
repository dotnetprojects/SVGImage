<UserControl x:Class="Example.FilterFeaturesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svg="https://github.com/dotnetprojects/SVGImage"
    Loaded="OnLoaded" Background="#F3F5F9">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="Lighting, images and backdrops" FontSize="26" FontWeight="SemiBold" Foreground="#18243B"/>
        <TextBlock Grid.Row="1" Text="Original offline examples of SVG lighting, image inputs and background composition. Select a feature to inspect its rendering and SVG source." TextWrapping="Wrap" Margin="0,8,0,16" Foreground="#485775"/>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ListBox x:Name="Features" DisplayMemberPath="Title" FontSize="15" Padding="8" SelectionChanged="SelectFeature"/>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="3*"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/></Grid.RowDefinitions>
                <TextBlock x:Name="Description" Margin="0,0,0,12" TextWrapping="Wrap" Foreground="#485775"/>
                <Border Grid.Row="1" Background="White" BorderBrush="#D5DEEB" BorderThickness="1" CornerRadius="12" Padding="16">
                    <svg:SVGImage x:Name="Preview" UseAnimations="False" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                </Border>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12">
                    <Button Content="Reload" Padding="18,7" Click="Restart"/>

                </StackPanel>
                <TextBox Grid.Row="3" x:Name="SourceCode" IsReadOnly="True" IsUndoEnabled="False" FontFamily="Consolas" FontSize="12" Padding="10"
                    Background="#18243B" Foreground="#E7EDF9" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
