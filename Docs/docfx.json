{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "SVGImage/DotNetProjects.SVGImage.csproj"
          ],
          "src": "../Source/"
        }
      ],
      "dest": "api",
      "outputFormat": "mref",
      "includePrivateMembers": false,
      "disableGitFeatures": false,
      "disableDefaultFilter": false,
      "noRestore": false,
      "namespaceLayout": "flattened",
      "memberLayout": "samePage",
      "enumSortOrder": "alphabetic",
      "allowCompilationErrors": false,
      "properties": {
        "TargetFramework": "net8.0-windows",
        "TargetFrameworks": "net8.0-windows",
        "GeneratePackageOnBuild": "false"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**.yml",
          "api/index.md"
        ]
      },
      {
        "files": [
          "articles/**.md",
          "articles/**/toc.yml",
          "toc.yml",
          "*.md"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "globalMetadata": {
      "_appName": "SVGImage",
      "_appTitle": "SVGImage",
      "_appLogoPath": "images/logo.svg",
      "_appFaviconPath": "images/logo.svg",
      "_enableDiagrams": true,
      "_enableSearch": true,
      "_appFooter": "<div class=\"svg-footer\"><span>SVGImage \u00b7 Native SVG for WPF</span><span>MIT licensed \u00b7 <a href=\"https://github.com/dotnetprojects/SVGImage\">Built in the open</a> \u00b7 \u00a9 2020\u20132026 DotNetProjects</span></div>",
      "_gitContribute": {
        "repo": "https://github.com/dotnetprojects/SVGImage",
        "branch": "master"
      },
      "_gitUrlPattern": "github",
      "_lang": "en"
    },
    "output": "_site",
    "globalMetadataFiles": [],
    "fileMetadataFiles": [],
    "template": [
      "default",
      "modern",
      "template"
    ],
    "postProcessors": [],
    "keepFileLink": false,
    "disableGitFeatures": false
  }
}
